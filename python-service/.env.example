# Python service (records microservice)
PORT=8000

# PostgreSQL — same database as node-service; this service owns the records table
DATABASE_URL=postgres://postgres:password@localhost:5432/interview_app

# Must match node-service JWT_SECRET exactly
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Only this origin may call the API from a browser
CORS_ORIGIN=http://localhost:5173
