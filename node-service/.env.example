# Node service (main business API)
PORT=5000

# PostgreSQL — shared with python-service
DATABASE_URL=postgres://postgres:password@localhost:5432/interview_app

# JWT — JWT_SECRET must be identical in python-service/.env
JWT_SECRET=change-me
JWT_EXPIRES_IN=4h

# Redis (local install, no Docker). Change REDIS_PORT if 6379 is taken.
REDIS_HOST=localhost
REDIS_PORT=6379

# Login rate limit: max attempts per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Only this origin may call the API from a browser
CORS_ORIGIN=http://localhost:5173
